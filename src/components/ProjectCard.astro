---
import type { CollectionEntry } from "astro:content";
import { projectHighlights } from "../data/project-highlights";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const isFlagship = data.flagship;
const homepageTechnologies = data.homepageTechnologies ?? data.technologies.slice(0, isFlagship ? 5 : 4);
const highlight = projectHighlights[project.id];
const homepageEvidence = highlight?.links ?? data.evidence
  .filter((item) => item.type !== "commit-history")
  .slice(0, data.caseStudyPath ? 1 : 2);
---

<article class:list={["project-card", { "project-card--flagship": isFlagship }]}>
  <div class="project-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
  <div class="project-content">
    <div class="project-meta">
      {isFlagship && <span class="project-featured-label">Featured case study</span>}
      <p class="project-role">{data.roleLabel}</p>
    </div>
    <h3>{data.shortTitle}</h3>
    <p class="project-summary">{data.summary}</p>

    <div class="contribution">
      <span>My contribution</span>
      <p>{data.homepageContribution ?? data.contribution}</p>
    </div>

    {highlight && (
      <div class="project-result">
        <ul aria-label={`${data.shortTitle} results and context`}>
          {highlight.indicators.map((indicator) => <li>{indicator}</li>)}
        </ul>
        {highlight.context && <p>{highlight.context}</p>}
      </div>
    )}

    <ul class="technology-list" aria-label={`${data.shortTitle} technologies`}>
      {homepageTechnologies.map((technology) => <li>{technology}</li>)}
    </ul>

    <div class="evidence-links" aria-label={`${data.shortTitle} evidence`}>
      {data.caseStudyPath && (
        <a href={data.caseStudyPath}>
          View case study <span aria-hidden="true">→</span>
        </a>
      )}
      {homepageEvidence.map((item) => (
        <a href={item.url} target="_blank" rel="noopener">
          {item.label}
          <span aria-hidden="true"> ↗</span>
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .project-result { grid-column: 1 / -1; }
  .project-result ul { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin: 0; padding: 0; list-style: none; }
  .project-result li { color: var(--accent-dark); font-size: 0.9rem; font-weight: 650; }
  .project-result p { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.9rem; }
</style>
